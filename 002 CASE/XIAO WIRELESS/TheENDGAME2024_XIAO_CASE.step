#45522 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#45523 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#45524 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(5.E-04),#45521,
  'distance_accuracy_value','confusion accuracy');
#45525 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
ENDSEC;
END-ISO-10303-21;
