#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

#define LOWER 1
#define RAISE 2

/* The stock nice!nano v2 ext-power node enables P0.13 at boot and saves its
 * state, and lets a keymap turn it off. The switched rail feeds both the
 * status LED and the Cirque touchpad, so status-pulse owns it instead: on
 * before the touchpad driver starts, off only when ZMK goes to sleep. */
&{/EXT_POWER} {
    status = "disabled";
};

/* P0.09 (D10, touchpad DR) and P0.10 (D16, I2C SCL) are the nRF52840 NFC
 * pads. The nice!nano board does not release them, so do it here. */
&uicr {
    nfct-pins-as-gpios;
};

&gpio0 {
    led_din_low {
        gpio-hog;
        gpios = <6 GPIO_ACTIVE_HIGH>;
        output-low;
        line-name = "endgame-led-din-low";
    };
};

&pinctrl {
    /* &pro_micro_i2c defaults to D2/D3, which are matrix columns here. */
    endgame_i2c0_default: endgame_i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 11)>,    /* D14 */
                    <NRF_PSEL(TWIM_SCL, 0, 10)>;    /* D16 */
        };
    };

    endgame_i2c0_sleep: endgame_i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 11)>,
                    <NRF_PSEL(TWIM_SCL, 0, 10)>;
            low-power-enable;
        };
    };

    endgame_spi3_default: endgame_spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
        };
    };

    endgame_spi3_sleep: endgame_spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&endgame_spi3_default>;
    pinctrl-1 = <&endgame_spi3_sleep>;
    pinctrl-names = "default", "sleep";

    status_pixel: ws2812@0 {
        compatible = "endgame,ws2812-v6-spi";
        reg = <0>;
        spi-max-frequency = <16000000>;
    };
};

/* 4.7 kOhm pull-ups to the switched VCC rail are on the PCB. */
&i2c0 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    clock-frequency = <100000>;    /* 100 kHz */
    pinctrl-0 = <&endgame_i2c0_default>;
    pinctrl-1 = <&endgame_i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    /* TM040040 strapped for I2C (R1 removed). No sleep-mode-enable: the
     * Pinnacle can fail to wake from its own low-power mode on this driver. */
    glidepoint: trackpad@2a {
        compatible = "cirque,pinnacle";
        reg = <0x2a>;
        status = "okay";
        data-mode = "relative";
        sensitivity = "1x";
        data-ready-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;    /* D10 */
        primary-tap-enable;
    };
};

/ {
    glidepoint_listener {
        compatible = "zmk,input-listener";
        device = <&glidepoint>;
        input-processors
            = <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>
            , <&zip_xy_scaler 3 1>
            ;

        /* Holding Raise turns the pad into a scroll surface. */
        scroll {
            layers = <RAISE>;
            input-processors
                = <&zip_xy_scaler 1 20>
                , <&zip_xy_to_scroll_mapper>
                ;
        };
    };

    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        zmk,battery = &vbatt;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0, 0) RC(0, 1) RC(0, 2) RC(0, 3) RC(0, 4) RC(0, 5) RC(0, 6) RC(0, 7) RC(0, 8) RC(0, 9)
            RC(1, 0) RC(1, 1) RC(1, 2) RC(1, 3) RC(1, 4) RC(1, 5) RC(1, 6) RC(1, 7) RC(1, 8) RC(1, 9)
            RC(2, 0) RC(2, 1) RC(2, 2) RC(2, 3) RC(2, 4) RC(2, 5) RC(2, 6) RC(2, 7) RC(2, 8) RC(2, 9)
            RC(3, 0) RC(3, 3) RC(3, 4) RC(3, 5) RC(3, 6) RC(3, 9)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
        row-gpios =
            <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        col-gpios =
            <&pro_micro 0 GPIO_ACTIVE_HIGH>,
            <&pro_micro 2 GPIO_ACTIVE_HIGH>,
            <&pro_micro 3 GPIO_ACTIVE_HIGH>,
            <&pro_micro 4 GPIO_ACTIVE_HIGH>,
            <&pro_micro 5 GPIO_ACTIVE_HIGH>,
            <&pro_micro 21 GPIO_ACTIVE_HIGH>,
            <&pro_micro 20 GPIO_ACTIVE_HIGH>,
            <&pro_micro 19 GPIO_ACTIVE_HIGH>,
            <&pro_micro 18 GPIO_ACTIVE_HIGH>,
            <&pro_micro 15 GPIO_ACTIVE_HIGH>;
    };

    behaviors {
        status_pulse: status_pulse {
            compatible = "zmk,behavior-endgame-status-pulse";
            #binding-cells = <0>;
        };
    };
};
