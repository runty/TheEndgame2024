+static void kscan_matrix_retry_after_spi_error(const struct device *dev) {
+    struct kscan_matrix_data *data = dev->data;
+    struct k_work_delayable *work = &data->work;
+
+    if (data->spi_retry_count < 5) {
+        const uint32_t delay_ms = 10U << data->spi_retry_count;
+        data->spi_retry_count++;
+        k_work_reschedule(work, K_MSEC(delay_ms));
+        return;
+    }
+
+    if (!data->spi_error_logged) {
+        LOG_ERR("SPI-backed matrix scan keeps failing; restoring row wake interrupts");
+        data->spi_error_logged = true;
+    }
+#if USE_INTERRUPTS
+    // Clear before re-arming. If enabling the row IRQ triggers an ISR, its new
+    // pending scan must not be cleared after the call returns.
+    atomic_clear(&data->interrupt_scan_pending);
+    int err = kscan_matrix_interrupt_enable(dev);
+    if (!err) {
+        // A row IRQ may have queued another scan immediately. Keep the rows
+        // masked and delay that retry so a persistent bus error cannot spin.
+        data->spi_retry_after_ms = k_uptime_get() + 1000;
+        return;
+    }
+    if (!data->spi_error_logged) {
+        LOG_ERR("Unable to restore row wake interrupts: %i", err);
+        data->spi_error_logged = true;
+    }
+#endif
+
+    // Keep recovery alive at a low rate. k_work_schedule does not replace an
+    // immediate retry already queued by a newly-triggered row interrupt.
+    atomic_set(&data->interrupt_scan_pending, 1);
+    data->spi_retry_count = 5;
+    data->spi_retry_after_ms = 0;
+    k_work_schedule(work, K_SECONDS(1));
+}
+
 static void kscan_matrix_work_handler(struct k_work *work) {
     struct k_work_delayable *dwork = k_work_delayable_from_work(work);
     struct kscan_matrix_data *data = CONTAINER_OF(dwork, struct kscan_matrix_data, work);
-    kscan_matrix_read(data->dev);
+
+    if (data->spi_retry_count >= 5) {
+        int64_t delay_ms = data->spi_retry_after_ms - k_uptime_get();
+        if (delay_ms > 0) {
+            k_work_reschedule(&data->work, K_MSEC(delay_ms));
+            return;
+        }
+    }
+
+    if (atomic_get(&data->interrupt_scan_pending)) {
+        int err = kscan_matrix_set_all_outputs(data->dev, 0);
+        if (err) {
+            kscan_matrix_retry_after_spi_error(data->dev);
+            return;
+        }
+        atomic_clear(&data->interrupt_scan_pending);
+    }
+
+    int err = kscan_matrix_read(data->dev);
+    if (err) {
+        atomic_set(&data->interrupt_scan_pending, 1);
+        kscan_matrix_retry_after_spi_error(data->dev);
+        return;
+    }
+
+    data->spi_retry_count = 0;
+    data->spi_error_logged = false;
+    data->spi_retry_after_ms = 0;
 }
 
