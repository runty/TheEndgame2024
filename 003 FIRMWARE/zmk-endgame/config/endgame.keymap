#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define LOWER 1
#define RAISE 2

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
                &kp Q    &kp W    &kp E    &kp R    &kp T                 &kp Y    &kp U    &kp I      &kp O    &kp P
                &kp A    &kp S    &kp D    &kp F    &kp G                 &kp H    &kp J    &kp K      &kp L    &kp SCLN
                &kp Z    &kp X    &kp C    &kp V    &kp B                 &kp N    &kp M    &kp COMMA  &kp DOT  &kp FSLH
                &kp LSFT                   &lt LOWER ESC &kp RET           &kp SPACE &lt RAISE DEL             &kp RSFT
            >;
        };

        lower_layer {
            bindings = <
                &kp N1    &kp N2    &kp N3    &kp N4    &kp N5               &kp N6    &kp N7    &kp N8    &kp N9    &kp N0
                &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT             &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR
                &kp GRAVE &kp TILDE &kp PIPE  &kp BSLH  &kp MINUS             &kp EQUAL &kp LBKT  &kp RBKT  &kp LBRC  &kp RBRC
                &kp LSFT                   &trans      &kp RET               &kp SPACE &trans                  &kp RSFT
            >;
        };

        raise_layer {
            bindings = <
                &kp F1    &kp F2    &kp F3    &kp F4    &kp F5               &kp F6    &kp F7    &kp F8    &kp F9    &kp F10
                &kp HOME  &kp PG_DN &kp PG_UP &kp END   &kp INS              &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp F11
                &kp LBRC  &kp RBRC  &kp TAB  &kp BSPC  &kp DEL              &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_NXT &kp F12
                &kp LSFT                   &trans      &kp RET               &kp SPACE &bt BT_CLR               &kp RSFT
            >;
        };
    };
};
