/*
 * Sample keymap for the wired RP2040-Zero Choc V2 Endgame.
 * A plain QWERTY starting point; replace it with your own layout.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
                &kp Q    &kp W    &kp E    &kp R    &kp T                 &kp Y    &kp U    &kp I      &kp O    &kp P
                &kp A    &kp S    &kp D    &kp F    &kp G                 &kp H    &kp J    &kp K      &kp L    &kp SCLN
                &kp Z    &kp X    &kp C    &kp V    &kp B                 &kp N    &kp M    &kp COMMA  &kp DOT  &kp FSLH
                &kp LSFT                   &lt LOWER ESC &kp RET           &kp SPACE &lt RAISE BSPC            &kp RSFT
            >;
        };

        lower_layer {
            bindings = <
                &kp N1    &kp N2    &kp N3    &kp N4    &kp N5               &kp N6    &kp N7    &kp N8    &kp N9    &kp N0
                &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT             &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR
                &kp GRAVE &kp TILDE &kp PIPE  &kp BSLH  &kp MINUS             &kp EQUAL &kp LBKT  &kp RBKT  &kp SQT   &kp DQT
                &kp LCTRL                  &trans      &kp TAB               &kp SPACE &kp DEL                 &kp LALT
            >;
        };

        raise_layer {
            bindings = <
                &kp F1    &kp F2    &kp F3    &kp F4    &kp F5               &kp F6    &kp F7    &kp F8    &kp F9    &kp F10
                &kp HOME  &kp PG_DN &kp PG_UP &kp END   &kp INS              &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp F11
                &rgb_ug RGB_TOG &rgb_ug RGB_EFF &rgb_ug RGB_HUI &rgb_ug RGB_BRI &rgb_ug RGB_BRD    &kp C_PREV &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT &kp F12
                &bootloader                &kp LGUI    &kp RET               &kp SPACE &trans                  &sys_reset
            >;
        };
    };
};
